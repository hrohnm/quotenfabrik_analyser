# Quotenfabrik privates Frontend (Next.js, vorher "npm run build") – nur lokal, öffentlich über nginx.
[Unit]
Description=Quotenfabrik Frontend
After=network-online.target qf-api.service
Wants=network-online.target

[Service]
User=qf
WorkingDirectory=/home/qf/quotenfabrik_analyser/frontend-private
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
