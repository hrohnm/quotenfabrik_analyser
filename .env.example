# Copy to .env (never commit .env)
API_FOOTBALL_KEY=
DATABASE_URL=postgresql+psycopg://qf:qf@localhost:5432/quotenfabrik

# Leagues: API-Football ids and matching football-data.co.uk codes (same order)
QF_LEAGUES=78,79
QF_FD_LEAGUES=D1,D2

# API-Football throttling and daily reserve for odds snapshots
QF_API_MAX_RPS=4
QF_API_QUOTA_RESERVE=500

# Archived bookmakers: Betano (32, target), Pinnacle (4, reference), Bet365 (8, fallback markets)
QF_ODDS_BOOKMAKERS=32,4,8

# OddsPapi (Betano odds): free plan = 250 requests/month, /v4/historical-odds is free
ODDSPAPI_API_KEY=
QF_ODDSPAPI_TOURNAMENTS=35,44
QF_ODDSPAPI_BOOKMAKERS=betano.de,pinnacle

# Optional: database for integration tests (will be wiped)
# QF_TEST_DATABASE_URL=postgresql+psycopg://qf:qf@localhost:5432/quotenfabrik_test
